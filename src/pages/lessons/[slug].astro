---
import { getCollection, render } from 'astro:content'
import DocumentToc from '../../components/DocumentToc.astro'
import MarkdownContent from '../../components/MarkdownContent.astro'
import { siteCopy } from '../../data/site-copy'
import Layout from '../../layouts/Layout.astro'
import { withBase } from '../../lib/paths'

export async function getStaticPaths() {
  const lessons = await getCollection('lessons')
  return lessons.map((lesson) => ({
    params: { slug: lesson.id.replace(/\.mdx?$/, '') },
    props: { lesson },
  }))
}

const { lesson } = Astro.props
const { Content, headings } = await render(lesson)
const titleParts = lesson.data.title.match(/^(.*?)([a-z][\w-]*(?:\s+-[\w-]+)+)$/i)
const toc = headings
  .filter((heading) => heading.depth === 2)
  .map((heading) => ({
    href: `#${heading.slug}`,
    label: heading.text.replace(/^\d+\.\s*/, ''),
  }))
const lessons = await getCollection('lessons')
lessons.sort((a, b) => a.data.week - b.data.week)
const index = lessons.findIndex((item) => item.id === lesson.id)
const prev = index > 0 ? lessons[index - 1] : null
const next = index < lessons.length - 1 ? lessons[index + 1] : null
---

<Layout title={lesson.data.title} description={lesson.data.description}>
  <article>
    <header class="relative overflow-hidden bg-[#f4c84f] px-6 py-10 sm:px-10 lg:px-12 lg:py-14">
      <div class="pointer-events-none absolute inset-0 opacity-20 [background-image:radial-gradient(#075486_1px,transparent_1px)] [background-size:18px_18px]"></div>
      <div class="relative mx-auto max-w-[1280px]">
        <p class="font-mono text-sm font-bold tracking-[.15em] text-[#075486]/70">{siteCopy.routes.lesson.label} {String(lesson.data.week).padStart(2, '0')} / {siteCopy.routes.lesson.reader}</p>
        <h1 class="mt-4 text-[clamp(2.6rem,4.2vw,4rem)] font-bold leading-[1.02] tracking-[-.06em] xl:whitespace-nowrap">{titleParts ? <>{titleParts[1]}<code class="whitespace-nowrap bg-transparent p-0 font-mono text-[.92em] font-bold tracking-[-.05em] text-inherit">{titleParts[2]}</code></> : lesson.data.title}</h1>
        <p class="mt-6 max-w-[820px] border-l-[6px] border-[#ef795e] bg-[#fffaf0] px-6 py-4 text-lg font-semibold leading-8 text-[#335f78]">{lesson.data.description}</p>
      </div>
    </header>
    <div class="bg-[#fffaf0] bg-[repeating-linear-gradient(0deg,transparent_0,transparent_8px,rgba(7,84,134,.11)_8px,rgba(7,84,134,.11)_10px)] px-5 py-12 sm:px-10 lg:px-12 lg:py-16">
      <div class="mx-auto grid max-w-[1200px] gap-9 lg:grid-cols-[260px_1fr]">
        <DocumentToc eyebrow={siteCopy.routes.lesson.guide} title={siteCopy.routes.lesson.tocLabel} items={toc} />
        <MarkdownContent framed><Content /></MarkdownContent>
      </div>
    </div>
    <nav class="mx-auto grid max-w-[1280px] gap-5 px-6 py-12 sm:grid-cols-2 sm:px-10 lg:px-12">
      {prev ? <a href={withBase(`/lessons/${prev.id.replace(/\.mdx?$/, '')}`)} class="rounded-[4px] border-2 border-[#075486] bg-[#b8d8e8] p-6"><span class="font-mono text-sm text-[#4f7892]">{siteCopy.routes.lesson.previous}</span><p class="mt-3 text-xl font-bold">{siteCopy.routes.lesson.unitPrefix}{String(prev.data.week).padStart(2, '0')}{siteCopy.routes.lesson.unitSeparator}{prev.data.title}</p></a> : <a href={withBase('/preparation')} class="rounded-[4px] border-2 border-[#075486] bg-[#b8d8e8] p-6"><span class="font-mono text-sm text-[#4f7892]">{siteCopy.routes.lesson.preparation}</span><p class="mt-3 text-xl font-bold">{siteCopy.routes.lesson.preparationTitle}</p></a>}
      {next ? <a href={withBase(`/lessons/${next.id.replace(/\.mdx?$/, '')}`)} class="rounded-[4px] border-2 border-[#075486] bg-[#075486] p-6 text-[#fffaf0] sm:text-right"><span class="font-mono text-sm text-[#a9d1e3]">{siteCopy.routes.lesson.next}</span><p class="mt-3 text-xl font-bold">{siteCopy.routes.lesson.unitPrefix}{String(next.data.week).padStart(2, '0')}{siteCopy.routes.lesson.unitSeparator}{next.data.title}</p></a> : <a href={withBase('/')} class="rounded-[4px] border-2 border-[#075486] bg-[#075486] p-6 text-[#fffaf0] sm:text-right"><span class="font-mono text-sm text-[#a9d1e3]">{siteCopy.routes.lesson.overview}</span><p class="mt-3 text-xl font-bold">{siteCopy.routes.lesson.overviewTitle}</p></a>}
    </nav>
  </article>
</Layout>
