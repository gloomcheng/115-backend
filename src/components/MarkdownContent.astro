---
interface Props {
  framed?: boolean
  compact?: boolean
}

const { framed = false, compact = false } = Astro.props
---

<div
  class:list={[
    'prose min-w-0 max-w-none prose-headings:font-sans prose-headings:font-bold prose-headings:tracking-[-.035em] prose-headings:text-[#075486] prose-h2:mt-16 prose-h2:text-4xl prose-h3:text-2xl prose-p:text-[#274f67] prose-p:leading-8 prose-li:text-[#274f67] prose-a:text-[#075486] prose-a:decoration-[#ef795e] prose-strong:text-[#075486] prose-pre:bg-[#075486] prose-pre:text-[#fffaf0] prose-img:mt-10 prose-img:mb-0 prose-img:w-full prose-img:rounded-none prose-img:bg-[#fffaf0] prose-code:rounded-[2px] prose-code:bg-[#e7f0f4] prose-code:px-1 prose-code:py-0.5 prose-code:font-mono prose-code:font-medium prose-code:text-[#075486] prose-hr:my-[4.5rem] prose-hr:h-[10px] prose-hr:border-0 prose-hr:bg-[repeating-linear-gradient(0deg,transparent_0,transparent_3px,rgba(7,84,134,.2)_3px,rgba(7,84,134,.2)_5px)] [&_code::before]:content-none [&_code::after]:content-none [&_table]:block [&_table]:max-w-full [&_table]:overflow-x-auto',
    compact ? 'prose-base' : 'prose-lg',
    framed && 'rounded-[4px] border-2 border-[#075486] bg-[#fffdf7] px-6 py-10 sm:px-10 lg:px-12 lg:py-14',
  ]}
>
  <slot />
</div>
