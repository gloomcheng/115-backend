---
interface Props {
  type?: 'note' | 'warning' | 'tip' | 'case' | 'important'
  title?: string
}
const { type = 'note', title } = Astro.props

const styles = {
  note: {
    container:
      'bg-[#fcfcfb] border border-[#e8e8e3] border-l-4 border-l-[#0c0c0c] p-6 sm:p-7 my-8 rounded-[4px] text-[#222222]',
    tag: 'text-[#666666]',
    title: 'text-[#0c0c0c]',
    defaultTag: 'NOTE',
  },
  tip: {
    container:
      'bg-[#f4f7fb] border border-[#d6e2ef] border-l-4 border-l-[#0f4c81] p-6 sm:p-7 my-8 rounded-[4px] text-[#1c3550]',
    tag: 'text-[#0f4c81]',
    title: 'text-[#0f4c81]',
    defaultTag: 'TIP',
  },
  warning: {
    container:
      'bg-[#fcf2f2] border border-[#edd2d2] border-l-4 border-l-[#c92a2a] p-6 sm:p-7 my-8 rounded-[4px] text-[#4a1c1c]',
    tag: 'text-[#c92a2a]',
    title: 'text-[#c92a2a]',
    defaultTag: 'WARNING',
  },
  case: {
    container:
      'bg-[#fcfcfb] border border-[#e8e8e3] border-l-4 border-l-[#0f4c81] p-6 sm:p-7 my-8 rounded-[4px] text-[#222222]',
    tag: 'text-[#0f4c81]',
    title: 'text-[#0c0c0c]',
    defaultTag: 'CASE STUDY',
  },
  important: {
    container:
      'bg-[#fffbf0] border border-[#ebd37f] border-l-4 border-l-[#075486] p-6 sm:p-7 my-8 rounded-[4px] text-[#274f67]',
    tag: 'text-[#075486]',
    title: 'text-[#075486]',
    defaultTag: 'IMPORTANT',
  },
}

const current = styles[type] || styles.note
---

<div class={`not-prose ${current.container}`}>
  <div class="flex flex-wrap items-baseline gap-2.5 font-mono text-xs tracking-wider border-b border-current/15 pb-2.5 mb-4">
    <span class={`font-bold uppercase ${current.tag}`}>[{current.defaultTag}]</span>
    {title && <span class={`font-display text-base font-bold tracking-normal ${current.title}`}>{title}</span>}
  </div>
  <div
    class:list={[
      'text-base leading-7 space-y-4',
      '[&_p]:m-0 [&_p]:leading-7',
      '[&_pre]:my-4 [&_pre]:p-4 [&_pre]:rounded-[4px] [&_pre]:text-sm [&_pre]:leading-relaxed [&_pre]:overflow-x-auto',
      '[&_ol]:my-4 [&_ol]:list-decimal [&_ol]:pl-6 [&_ol]:space-y-2.5',
      '[&_ul]:my-4 [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:space-y-2.5',
      '[&_li]:leading-7 [&_li]:pl-1',
      '[&_code]:rounded-[3px] [&_code]:bg-black/5 [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-sm [&_pre_code]:bg-transparent [&_pre_code]:p-0',
      '[&_strong]:font-bold',
    ]}
  >
    <slot />
  </div>
</div>
