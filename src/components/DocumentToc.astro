---
interface TocItem {
  href: string
  label: string
  n?: string
}

interface Props {
  eyebrow: string
  title: string
  items: TocItem[]
}

const { eyebrow, title, items } = Astro.props
---

<aside class="h-fit rounded-[4px] border-2 border-[#075486] bg-[#b8d8e8] p-6 lg:sticky lg:top-6">
  <p class="font-mono text-xs font-bold tracking-[.14em]">{eyebrow}</p>
  <p class="mt-2 text-2xl font-bold">{title}</p>
  <ol class="mt-5 space-y-3">
    {items.map((item, index) => (
      <li>
        <a href={item.href} class="flex gap-3 text-sm font-semibold leading-5">
          <span class="shrink-0 font-mono text-[#ef795e]">{item.n ?? String(index + 1).padStart(2, '0')}</span>
          <span>{item.label}</span>
        </a>
      </li>
    ))}
  </ol>
</aside>
