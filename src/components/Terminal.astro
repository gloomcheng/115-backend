---
interface Props {
  title?: string
  flavor?: 'powershell' | 'wsl' | 'iterm' | 'bash' | 'output'
}

const { title = 'bash', flavor } = Astro.props
const lowerTitle = title.toLowerCase()
const isPwsh =
  flavor === 'powershell' || lowerTitle.includes('powershell') || lowerTitle.includes('pwsh')
const isWsl = flavor === 'wsl' || lowerTitle.includes('wsl') || lowerTitle.includes('ubuntu')
const isOutput = flavor === 'output'
const isIterm = flavor === 'iterm' || flavor === 'bash' || isOutput || (!isPwsh && !isWsl)
const code = (await Astro.slots.render('default')).trim()
---

<div
  role="region"
  aria-label={`Terminal code block: ${title}`}
  class:list={[
    'my-7 w-full max-w-full overflow-hidden rounded-[10px] border not-prose shadow-[0_18px_45px_rgba(9,30,48,.18)]',
    isPwsh || isWsl ? 'border-[#111]' : 'border-[#a9a9a9]',
  ]}
>
  {
    isIterm ? (
      <>
        <div class="relative flex h-9 items-center justify-center border-b border-[#b8b8b8] bg-[#e8e8e8] px-3 text-[#333]">
          <div class="absolute left-3 flex items-center gap-2" aria-hidden="true">
            <span class="h-3 w-3 rounded-full border border-[#df4744] bg-[#ff5f57]"></span>
            <span class="h-3 w-3 rounded-full border border-[#d99e21] bg-[#febc2e]"></span>
            <span class="h-3 w-3 rounded-full border border-[#27aa35] bg-[#28c840]"></span>
          </div>
          <span class="max-w-[55%] truncate font-mono text-xs font-medium">{title}</span>
        </div>
        <div class="flex h-8 items-end bg-[#282828] px-3">
          <div class="flex h-7 min-w-[180px] max-w-[65%] items-center gap-2 rounded-t-md bg-[#101010] px-3 font-mono text-xs text-[#d8d8d8]">
            <svg aria-hidden="true" viewBox="0 0 16 16" class="h-3 w-3 fill-none stroke-[#9ad36a] stroke-[1.6]"><path d="m3 4 3 4-3 4m5 0h5" /></svg>
            <span class="truncate">{title}</span>
          </div>
        </div>
        <pre set:html={code} class:list={['min-h-[150px] overflow-x-auto bg-[#101010] p-5 font-mono text-sm leading-7 text-[#f1f1ed]', !isOutput && "before:mr-2 before:inline before:text-[#8fd36b] before:content-['student@MacBook_~_%']"]} />
      </>
    ) : (
      <>
        <div class="flex h-10 items-stretch bg-[#202020] text-[#f3f3f3]">
          <div class="flex min-w-0 flex-1 items-end gap-1 pl-2 pt-2">
            <div class="flex h-8 min-w-[190px] max-w-[55%] items-center gap-2 rounded-t-md bg-[#323232] px-3 font-mono text-xs">
              {isPwsh ? (
                <svg aria-hidden="true" viewBox="0 0 20 20" class="h-4 w-4 rounded-[2px] bg-[#0f6cbd] p-[2px] fill-none stroke-white stroke-[2]"><path d="m4 5 4 5-4 5m6 0h6" /></svg>
              ) : (
                <svg aria-hidden="true" viewBox="0 0 20 20" class="h-4 w-4 rounded-full bg-[#e95420] p-[2px] fill-white"><path d="M4 5h12v10H4z" /><path d="m6 8 2 2-2 2m4 0h4" stroke="#e95420" stroke-width="1.5" fill="none" /></svg>
              )}
              <span class="truncate">{title}</span>
            </div>
            <span aria-hidden="true" class="grid h-8 w-8 place-items-center text-lg text-[#c8c8c8]">+</span>
            <svg aria-hidden="true" viewBox="0 0 16 16" class="mb-3 ml-1 h-3 w-3 fill-none stroke-[#c8c8c8] stroke-[1.5]"><path d="m3 6 5 5 5-5" /></svg>
          </div>
          <div class="flex shrink-0" aria-hidden="true">
            <span class="grid w-11 place-items-center"><span class="h-px w-3 bg-[#ddd]"></span></span>
            <span class="grid w-11 place-items-center"><span class="h-3 w-3 border border-[#ddd]"></span></span>
            <span class="grid w-11 place-items-center"><svg viewBox="0 0 16 16" class="h-3 w-3 stroke-[#ddd] stroke-[1.3]"><path d="m3 3 10 10M13 3 3 13" /></svg></span>
          </div>
        </div>
        {isPwsh ? (
          <pre set:html={code} class="min-h-[150px] overflow-x-auto bg-[#012456] p-5 font-mono text-sm leading-7 text-[#f4f7fb] before:mr-2 before:inline before:text-[#f4f7fb] before:content-['PS_C:\\Users\\student>']" />
        ) : (
          <pre set:html={code} class="min-h-[150px] overflow-x-auto bg-[#300a24] p-5 font-mono text-sm leading-7 text-[#f6f1f5] before:mr-2 before:inline before:font-bold before:text-[#8ae234] before:content-['student@ubuntu:~$']" />
        )}
      </>
    )
  }
</div>
