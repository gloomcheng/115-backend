---
import { siteCopy } from '../data/site-copy'
---

<footer id="site-footer" class="bg-[#075486] text-[#fffaf0]">
  <div class="mx-auto grid max-w-[1280px] gap-9 px-6 py-12 sm:px-10 md:grid-cols-3 lg:px-12">
    <div>
      <p class="text-xl font-bold">{siteCopy.footer.title}</p>
      <p class="mt-4 font-mono text-xs tracking-[.14em] text-[#a9d1e3]">{siteCopy.footer.editionLabel}</p>
      <p class="mt-2 text-sm font-semibold">{siteCopy.footer.edition}</p>
      <p class="mt-4 text-sm text-[#d7e7ef]">{siteCopy.footer.institution}</p>
    </div>
    <div>
      <p class="font-mono text-xs tracking-[.14em] text-[#a9d1e3]">{siteCopy.footer.authorLabel}</p>
      <p class="mt-3 text-base font-bold">{siteCopy.footer.author}</p>
      <p class="mt-5 font-mono text-xs tracking-[.14em] text-[#a9d1e3]">{siteCopy.footer.sourceLabel}</p>
      <a href={siteCopy.footer.sourceUrl} class="mt-2 inline-block text-sm font-semibold underline decoration-[#ef795e] decoration-2 underline-offset-4">{siteCopy.footer.sourceName}</a>
    </div>
    <div>
      <p class="font-mono text-xs tracking-[.14em] text-[#a9d1e3]">{siteCopy.footer.licenseLabel}</p>
      <a href={siteCopy.footer.licenseUrl} rel="license" class="mt-3 inline-block text-lg font-bold underline decoration-[#ef795e] decoration-2 underline-offset-4">{siteCopy.footer.licenseName}</a>
      <p class="mt-3 text-sm leading-7 text-[#d7e7ef]">{siteCopy.footer.licenseNote}</p>
    </div>
  </div>
</footer>
